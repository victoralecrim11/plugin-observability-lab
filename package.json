{
  "name": "observability-dev-toolkit",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Toolkit de observabilidade para Claude Code e Codex",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "node scripts/validate-package.mjs --path .",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run scan && npm run verify:versions && npm run validate && npm test",
    "build": "node scripts/build.mjs",
    "scan": "node scripts/security-scan.mjs",
    "verify:versions": "node scripts/bump-version.mjs --check",
    "release:patch": "node scripts/bump-version.mjs patch",
    "release:minor": "node scripts/bump-version.mjs minor",
    "release:major": "node scripts/bump-version.mjs major",
    "build:sync": "node scripts/build.mjs --sync"
  },
  "license": "MIT"
}
